# Copy to .env and fill in. Never commit .env — it holds the key that
# decrypts every business's Gemini credential.

PORT=4000

# ---------------------------------------------------------------------------
# Firestore
# ---------------------------------------------------------------------------
# This service stores aiSettings and aiInsightCache in Firestore, not Mongo.
# Project config, rules and indexes live in ../firebase.
#
# The database is NAMED `default` (no parentheses) because the project is on
# Firestore Enterprise edition, which does not create the conventional
# `(default)` database. Leave this alone unless the database is recreated.
FIRESTORE_DATABASE_ID=default

# The credential, one of two ways — the Admin SDK ignores the security rules
# in ../firebase/firestore.rules, so this is as sensitive as the data itself.
#
# 1. Local development: a path to the service-account JSON downloaded from
#    Firebase console → Project settings → Service accounts. Keep the file
#    OUTSIDE the repo, or named so ../firebase/.gitignore catches it.
#    Forward slashes work fine on Windows here.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/<you>/.secrets/<project>-firebase-adminsdk-<hash>.json
#
# 2. Hosts that offer env vars but no writable disk: the whole JSON, on one
#    line, in this variable. It wins over the path above.
#    The `private_key` newlines survive as the two characters \n; the code puts
#    them back, so paste the JSON exactly as downloaded.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"…"}
#
# On Cloud Run and Cloud Functions, set NEITHER: the runtime's own service
# account is picked up automatically. Grant it roles/datastore.user.

# ---------------------------------------------------------------------------
# Local emulator (optional)
# ---------------------------------------------------------------------------
# Uncomment to send every read and write to a Firestore running on this machine
# instead of the real one. Start it first, from ../firebase:
#
#   firebase emulators:start --only firestore
#
# Nothing else changes: no credential is needed, the data disappears when the
# emulator stops, and your Spark daily quota is untouched. The emulator does NOT
# enforce composite indexes, so a query that needs one passes here and fails in
# the cloud — run `npm run verify:firestore` against the real database before
# trusting a query.
# 8085, not the emulator's usual 8080: Apache (XAMPP) is already there.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# 32 bytes, hex-encoded (64 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotating this makes every stored key undecryptable, so store it somewhere
# durable before the first write. In production prefer AI_ENCRYPTION_KEY_FILE
# (a path to a file holding the hex) so the key never sits in `env` output —
# e.g. Docker secrets or a K8s secret volume. AI_ENCRYPTION_KEY_FILE wins
# when both are set.
#
# Firestore encrypting at rest does not replace this: it protects the disks,
# not a console session or a data export.
AI_ENCRYPTION_KEY=
# AI_ENCRYPTION_KEY_FILE=/run/secrets/ai_encryption_key

# The existing POS API. This service does not own auth, so it asks that API
# who a token belongs to before trusting it.
POS_API_URL=https://api.beta.rebuzzpos.com/api

# Where the frontend runs, for CORS.
#
# Only consulted if a browser calls this service directly. Today it does not:
# the Next.js route at app/api/settings/ai/ forwards to here server-to-server,
# and a server-to-server fetch sends no Origin header, so CORS never applies.
# Set this in production anyway — the service refuses to boot with NODE_ENV=
# production and no CORS_ORIGIN, because the first browser-side call would
# otherwise be blocked with no obvious cause. If this service is provably
# never called by a browser, ALLOW_DEFAULT_CORS=true opts out of that check.
CORS_ORIGIN=http://localhost:3000
# ALLOW_DEFAULT_CORS=true
